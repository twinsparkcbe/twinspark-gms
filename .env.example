# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role (secret) key — Project Settings > API > service_role.
# Server-only, used exclusively by lib/supabase/admin.ts for the User Roles
# module (create/deactivate accounts, reset passwords). NEVER prefix with
# NEXT_PUBLIC_, never commit the real value, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
